# Copy this file to corelynx.env and fill it in. corelynx.env is git-ignored: never commit it.

# Your Corelynx speech-to-text key (from the Corelynx dashboard)
CORELYNX_API_KEY=
CORELYNX_ENDPOINT=https://sttapi.corelynx.io/v1/transcribe

# The name you say before a command
WAKE_NAME=Zephyr

# The TV
TV_IP=192.168.1.97
TV_WIFI_MAC=

# Claude, for conversation (console.anthropic.com -> API Keys). Leave empty to turn chat off.
ANTHROPIC_API_KEY=

# Zephyr's voice: af_heart, af_bella, am_michael, bm_george, bf_emma, bm_fable
TTS_VOICE=af_heart

# Android phone as the mic (AndroidMic app, Wi-Fi/TCP mode, pointed at this laptop)
PHONE_MIC_PORT=55555
PHONE_MIC_GAIN=1.0

# ElevenLabs voice (elevenlabs.io); falls back to Kokoro if empty or out of credits
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=

# Spotify developer app Client ID; then run: python -P spotify.py login
SPOTIFY_CLIENT_ID=
